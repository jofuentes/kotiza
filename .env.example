# --- Mínimo indispensable para arrancar. Todo lo demás se configura desde la interfaz web. ---

# Nombre visible de la aplicación (pestaña del navegador, login, PDF)
APP_NAME=Kotiza

# URL pública con la que accedes a la app (sin "/" final)
APP_URL=http://localhost:8080
# Puerto del host donde se publica la app
APP_PORT=8080
# Nombre de la imagen Docker (cambia si corres varias instancias en el mismo equipo)
APP_IMAGE=cotizador:latest
# Clave de cifrado de credenciales (32 bytes en base64). Genérala con:
#   openssl rand -base64 32
# ¡No la cambies después de dar de alta credenciales o no podrán descifrarse!
APP_KEY=
APP_ENV=production
TZ=America/Mexico_City
# DNS que usa la app para consultar a los mayoristas (opcional)
# DNS_PRIMARY=1.1.1.1
# DNS_SECONDARY=8.8.8.8

# Base de datos (MariaDB del docker-compose)
DB_HOST=db
DB_PORT=3306
DB_NAME=cotizador
DB_USER=cotizador
DB_PASS=cambia-esta-contraseña
DB_ROOT_PASSWORD=cambia-esta-otra-contraseña

# La cuenta para recuperar contraseñas se configura en la sección Correo de la interfaz (Gmail).
# Solo si usas otro servidor SMTP (MAIL_ENCRYPTION: ssl, tls o none):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_ENCRYPTION=ssl
